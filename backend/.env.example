# Copy to backend/.env and fill in. Never commit the real file.
# PostgreSQL connection strings (database name for tests MUST end with _test).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cove_dev
DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/cove_test

# HTTP port for the API
PORT=3000

# Secret used to sign access JWTs. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more

# Browser origins allowed to call the API, comma separated, exact (no wildcard, no path).
# Default: the Vite dev server. In production list your real frontend origin.
# CORS_ORIGINS=http://localhost:5173

# Optional: global per-IP request ceiling for the whole API (defaults shown; /health and /ready exempt).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional: fatal | error | warn | info | debug | trace | silent (default info; silent under NODE_ENV=test).
# LOG_LEVEL=info

# Optional: failed logins allowed per IP per window (defaults shown).
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Optional: refresh token / cookie lifetime in seconds (default 604800 = 7 days).
# REFRESH_TOKEN_TTL_SECONDS=604800

# Used only by `npm run db:seed` (not by the running API).
# ADMIN_EMAIL / ADMIN_PASSWORD create (or promote) the one admin account. The password follows the
# registration policy (at least 10 characters, not a common password), so the CHANGE_ME placeholder is rejected.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# Optional: also create one plain USER for trying the buyer flow. Set both or neither.
# DEMO_USER_EMAIL=buyer@example.com
# DEMO_USER_PASSWORD=CHANGE_ME
