{
  "name": "cove",
  "version": "0.1.0",
  "private": true,
  "description": "Cove: car dealership inventory system (TDD kata)",
  "scripts": {
    "setup": "npm --prefix backend ci && npm --prefix backend run db:generate",
    "dev": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build",
    "test": "npm --prefix backend test",
    "test:coverage": "npm --prefix backend run test:coverage",
    "lint": "npm --prefix backend run lint",
    "typecheck": "npm --prefix backend run typecheck",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:reset": "npm --prefix backend run db:reset",
    "db:seed": "npm --prefix backend run db:seed"
  }
}
